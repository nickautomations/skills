# ──────────────────────────────────────────────────────────────────────────
# LinkedIn credentials for dynamic geo resolution (optional).
# Copy this file to ".env" and fill in values from the LinkedIn Developer
# Portal (My Apps -> your app -> "Auth" tab). Without this file, the skill
# falls back to the static regions.json and asks the user to add non-country
# locations in the Sales Navigator UI. Nothing breaks.
# ──────────────────────────────────────────────────────────────────────────

# OAuth 2.0 client credentials from the Auth tab.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must EXACTLY match a redirect URI registered in the portal.
# MUST be HTTPS. For the paste-redirect flow (recommended), the URL does not
# need to actually serve anything — you register it, the browser tries to
# redirect there, fails to load, and you copy the redirected URL from the
# address bar. Any HTTPS URL works (e.g. https://example.com/callback).
LINKEDIN_REDIRECT_URI=https://example.com/callback

# Scopes from the portal. r_ads is required for the geoTypeahead endpoint.
# Do not invent scopes that are not listed for your app.
LINKEDIN_SCOPES=r_ads

# LinkedIn REST API version (header: Linkedin-Version). Bump when LinkedIn
# ships a new dated version; the resolver is tested against 202607.
LINKEDIN_API_VERSION=202607

# Optional: supply a long-lived access token directly to bypass the local
# token cache and the OAuth flow entirely. If set, --auth is not needed.
# LINKEDIN_ACCESS_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# Advanced overrides (usually leave unset)
# ──────────────────────────────────────────────────────────────────────────

# Per-user writable data dir for the token cache and geo cache.
# Defaults to ~/.sales-nav-builder/ (or %LOCALAPPDATA%/sales-nav-builder on
# Windows). Set this if the skill directory is read-only and the default
# user dir is not suitable.
# SALES_NAV_DATA_HOME=

# Override the geo-cache.json path entirely (e.g. for a team-shared cache
# checked into a repo).
# SALES_NAV_GEO_CACHE=

# Callback server only (paste mode ignores these):
# LINKEDIN_CALLBACK_HOST=127.0.0.1
# LINKEDIN_CALLBACK_PORT=8765
